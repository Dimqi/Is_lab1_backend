                  <stringProp name="Header.value">Bearer ${__P(lab.flat-update.token,MISSING)}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="77412083">^200$${__jexl3((((&apos;${__P(lab.flat-update.code1,000)}&apos; == &apos;200&apos;) &amp;&amp; (&apos;${__P(lab.flat-update.code2,000)}&apos; == &apos;409&apos;)) || ((&apos;${__P(lab.flat-update.code2,000)}&apos; == &apos;200&apos;) &amp;&amp; (&apos;${__P(lab.flat-update.code1,000)}&apos; == &apos;409&apos;)) || ((&apos;${__P(lab.flat-update.code1,000)}&apos; == &apos;200&apos;) &amp;&amp; (&apos;${__P(lab.flat-update.code2,000)}&apos; == &apos;200&apos;))) ? &apos;&apos; : &apos;UNEXPECTED_RACE_STATUS&apos;)}</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <intProp name="Assertion.test_type">1</intProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Извлечь цену квартиры" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">price</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.price</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">MISSING</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Проверить площадь для итоговой цены" enabled="true">
              <stringProp name="JSON_PATH">$.area</stringProp>
              <stringProp name="EXPECTED_VALUE">${__jexl3((((&apos;${price}&apos; == &apos;5100000&apos;) &amp;&amp; (&apos;${__P(lab.flat-update.code1,000)}&apos; == &apos;200&apos;)) ? &apos;51&apos; : (((&apos;${price}&apos; == &apos;6200000&apos;) &amp;&amp; (&apos;${__P(lab.flat-update.code2,000)}&apos; == &apos;200&apos;)) ? &apos;62&apos; : &apos;NEVER&apos;)))}</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
